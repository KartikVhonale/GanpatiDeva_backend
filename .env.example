# =====================================================================
# Backend Environment Configuration (.env)
# =====================================================================
PORT=5000
JWT_SECRET=
ADMIN_DEFAULT_USER=
ADMIN_DEFAULT_PASS=
ADMIN_DEFAULT_PHONE=

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ganpati_utsav?retryWrites=true&w=majority

# Production Frontend URL (Your Vercel deployment URL, without trailing slash)
# Example: https://ganpati-utsav.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
